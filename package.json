{
  "name": "wdk-pay",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "simulate": "tsx src/db/simulate-payment.ts",
    "build:client": "cd client && npm run build",
    "build:sdk": "cd sdk && npx tsc",
    "postinstall": "npm run build:sdk"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@scure/bip32": "^2.2.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "fastify": "^5.8.5",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
