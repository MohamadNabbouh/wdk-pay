# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local Postgres (no auth):  postgres://localhost:5432/wdkpay
# Docker (docker compose up): postgres://wdkpay:wdkpay@localhost:5433/wdkpay
DATABASE_URL=postgres://localhost:5432/wdkpay
PORT=3000
BASE_URL=http://localhost:3000
NETWORK=mainnet
LOG_LEVEL=info

# WDK Indexer — required for payment detection
# Get a free key at https://wdk-api.tether.io/register
WDK_INDEXER_API_KEY=

